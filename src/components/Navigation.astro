---
const urlBuilder = (urlPath: String) => {
    const baseUrl = import.meta.env.BASE_URL;
    return baseUrl + `/${urlPath}`;
};
---

<div id="main-menu" class="nav-links">
    <a href={urlBuilder("")}>Home</a>
    <a href={urlBuilder("about")}>About</a>
    <a href={urlBuilder("blog")}>Blog</a>
</div>
